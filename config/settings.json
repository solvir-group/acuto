{
  // Fork settings. Source of truth lives here; config\apply.ps1 copies this into
  // <data-dir>\config\settings.json. Hot-reloads - no rebuild, no restart.

  "theme": {
    "mode": "dark",
    "dark": "Monochrome Dark",
    "light": "Monochrome Dark"
  },

  // ---------------------------------------------------------------- typography
  //
  // THE REM TRAP: ui_font_size is the rem base for ALL chrome, not the size of
  // chrome labels. Body UI text is 0.825rem (crates/ui/src/styles/typography.rs).
  // 15.5 * 0.825 = 12.8px labels, which is the 12.5-13px the spec asks for.
  // Setting this to 13 would give ~10.7px and shrink the entire UI.
  //
  // Name a font that is actually installed. This said "Inter", which is not on
  // this machine, so the choice fell to the font system -- and once Berkeley
  // Mono was installed the whole interface came back monospace, menus and
  // panels included. A first entry that resolves means the fallbacks never have
  // to be guessed at.
  "ui_font_family": "Segoe UI",
  "ui_font_fallbacks": ["Segoe UI Variable Text"],
  "ui_font_size": 15.5,
  "ui_font_weight": 400,

  // NOT Berkeley Mono Trial. The trial build swaps glyph outlines as its
  // watermark -- its own README build log says so:
  //
  //     FC-013: Swapping glyphs: backslash,slash
  //     FC-014: Swapping glyphs: asterisk,numbersign
  //
  // So `/` draws as `\`, `#` draws as `*`, and vice versa. Verified in the
  // font binary: `/` maps to glyph 72, whose outline falls left-to-right. In a
  // code editor that silently corrupts every comment, path, division, regex,
  // CSS colour, attribute and preprocessor line on screen -- and it is why
  // `</style>` appeared to be highlighted wrongly. It was drawn as `<\style>`.
  //
  // No setting can undo it; the fix is the licensed font. If that is bought,
  // change this one line back to its family name and delete this note.
  "buffer_font_family": "Cascadia Mono",
  "buffer_font_fallbacks": ["Consolas"],
  "buffer_font_size": 14,
  "buffer_font_weight": 400,
  // 1.75 was the original spec value, but these grotesque monos have a tall
  // x-height and are drawn around ~1.2. At 1.75 the glyphs sit in very sparse
  // rows and read as horizontally squashed even though advance width is
  // unchanged.
  "buffer_line_height": { "custom": 1.5 },

  // Two fonts in the whole editor: Segoe UI for anything you read, Cascadia
  // Mono for anything that is code. The agent panel follows the same split --
  // its prose in the UI font, the code it quotes in the code font -- rather
  // than introducing a third.
  "agent_ui_font_family": "Segoe UI",
  "agent_buffer_font_family": "Cascadia Mono",

  // UNSTABLE upstream ("expect many elements to be broken"). It is the single
  // biggest lever on density. FIRST THING TO REMOVE if the UI looks wrong.
  "unstable.ui_density": "compact",

  // Panel toggles close the panel when it is already focused, instead of only
  // moving focus back to the editor. Makes the title bar chat icon a real
  // on/off toggle rather than an "open" button.
  "close_panel_on_toggle": true,

  // ------------------------------------------------------------ language models
  //
  // Provider wiring only - NO API KEY HERE. This file is committed and pushed,
  // and a key in git history survives deleting the line. Zed stores provider keys
  // in the OS credential store; paste it once into the agent panel's provider
  // setup instead.
  //
  // `extra_body` is merged into every request to this model. Nemotron produces
  // no reasoning at all without `chat_template_kwargs.enable_thinking`, and it
  // is a vendor field that OpenAI's own schema has no room for -- so the agent
  // was running with its thinking switched off and no way to say otherwise.
  // The `reasoning_content` it then streams back is already understood.
  //
  // Reasoning is folded away in the transcript (see `thinking_display` below),
  // so this buys better answers without a wall of text.
  "language_models": {
    "openai_compatible": {
      "NVIDIA": {
        "api_url": "https://integrate.api.nvidia.com/v1",
        "available_models": [
          {
            "name": "nvidia/nemotron-3-super-120b-a12b",
            "display_name": "Nemotron 3 Super 120B",
            // Measured against the endpoint, not guessed: a 260,024-token
            // prompt is accepted. 16384 was the number here before, so the
            // agent had been discarding context to fit a window sixteen times
            // smaller than the one it actually had -- which is most of why it
            // forgot what it had just read. 200k leaves room for the reply
            // inside what was verified.
            "max_tokens": 200000,
            "max_output_tokens": 32768,
            "extra_body": {
              "chat_template_kwargs": { "enable_thinking": true }
            }
          }
        ]
      }
    }
  },

  // ------------------------------------------------------------------- layout
  // default preset: tree left, editor centre, agent right, terminal bottom.
  "project_panel": {
    "dock": "left",
    // The tree toggle lives on the toolbar row beside git and terminal. This
    // is the same control's status bar copy.
    "button": false,
    "default_width": 240,
    "entry_spacing": "standard",
    "indent_size": 20,
    "file_icons": true,
    "folder_icons": true,
    "git_status": true,
    "git_status_indicator": false,
    "diagnostic_badges": false,
    "indent_guides": { "show": "never" },
    "auto_fold_dirs": true,
    "bold_folder_labels": false
  },

  "agent": {
    "dock": "right",
    // Composer height. Default is 4 lines.
    "message_editor_min_lines": 2,
    // Fixed rather than filling the panel: the composer keeps a constant width
    // as the sidebar is resized, so it does not reflow while typing.
    "max_content_width": 420,
    // Reasoning stays folded away. The default expands it while streaming and
    // collapses it afterwards, which makes the transcript jump as the model
    // thinks; the summary line still says what it is doing.
    "thinking_display": "always_collapsed"
  },

  "terminal": {
    "dock": "bottom",
    // VS Code on Windows defaults to PowerShell, so this matches what that
    // terminal feels like. -NoLogo drops the copyright banner on every new
    // terminal, which was the "clean" part of the earlier Git Bash choice.
    // The acuto.bashrc shim only applied to bash; the `code` override for
    // PowerShell lives in terminal.env below instead.
    "shell": {
      "with_arguments": {
        "program": "powershell.exe",
        // -NoExit keeps the session interactive after sourcing our profile, so
        // the `code` shim applies here the way acuto.bashrc did for bash.
        "args": [
          "-NoLogo",
          "-NoExit",
          "-Command",
          ". 'C:/Users/broad/zed-fork-data/config/acuto.ps1'"
        ]
      }
    },
    // Editors spawned by git, npm and similar stay in this window.
    "env": {
      "EDITOR": "C:/Users/broad/zed/target/debug/zed.exe --user-data-dir C:/Users/broad/zed-fork-data --wait"
    },
    "font_family": "Cascadia Mono",
    "font_fallbacks": ["Consolas"],
    "font_size": 14,
    "line_height": { "custom": 1.5 }
  },

  // -------------------------------------------------------------------- chrome
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": true
  },

  "tabs": {
    "file_icons": false,
    "git_status": false,
    "show_close_button": "hover",
    "close_position": "right"
  },

  // Breadcrumbs stay: they carry position information. The rest is chrome that
  // duplicates the command palette.
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": false,
    "selections_menu": false,
    "code_actions": false
  },

  "title_bar": {
    // File / Edit / Selection / View / Go / Run / Window / Help, always visible
    // in the title bar instead of collapsed behind the hamburger. Off upstream.
    "show_menus": true,
    "show_branch_name": true,
    "show_branch_status_icon": true,
    "show_worktree_name": true,
    "show_project_items": true,
    "show_sign_in": false,
    "show_onboarding_banner": false,
    "show_user_picture": false
  },

  // ------------------------------------------------------------ code autofill
  //
  // The chat endpoint, not /v1/completions. NVIDIA's integrate API answers
  // /v1/completions with 404 for every model it serves, which is why inline
  // completions produced nothing at all before this - the request never
  // reached a model. Verified against the live endpoint, not inferred.
  //
  // A URL ending in /chat/completions makes the provider send a chat request
  // with the caret marked in the file, rather than a fill-in-the-middle
  // prompt. That is a worse instrument than a FIM base model and it is the
  // one on offer.
  //
  // The model is the same one the agent chats with, so there is one provider
  // and one key to keep working. The key comes from
  // ZED_OPEN_AI_COMPATIBLE_EDIT_PREDICTION_API_KEY, set in main.rs.
  //
  // `prompt_format` is unused on the chat path - it selects a FIM template
  // that a chat request never sends. It has to stay set to something that is
  // neither "infer" nor a zeta format, because that is what routes the request
  // down the FIM path in the first place.
  "edit_predictions": {
    "provider": "open_ai_compatible_api",
    "open_ai_compatible_api": {
      "api_url": "https://integrate.api.nvidia.com/v1/chat/completions",
      "model": "nvidia/nemotron-3-super-120b-a12b",
      "prompt_format": "qwen",
      "max_output_tokens": 96,
      // Milliseconds of quiet before a request goes out. The default is 0,
      // which suits a fill-in-the-middle model answering in tens of
      // milliseconds; against a chat model that takes about a second, firing
      // on every pause spends most requests on text the caret has already
      // left. Raise it if completions feel like they interrupt rather than
      // help; lower it if they feel late.
      "prediction_debounce": 300
    }
  },

  // Display switch, separate from the provider above. Stated explicitly so a
  // silent default can never be the reason nothing appears.
  "show_edit_predictions": true,
  "edit_predictions_disabled_in": [],

  // Spec: branch, LSP, cursor position, focus timer, layout preset switcher.
  // Focus timer and preset switcher do not exist yet - they are Rust, later.
  "status_bar": {
    "experimental.show": true,
    "show_active_file": false,
    "active_language_button": false,
    "cursor_position_button": true,
    "line_endings_button": false,
    "active_encoding_button": "disabled"
  }
}
